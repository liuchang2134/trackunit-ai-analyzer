# Data source
DATA_SOURCE=mock

# Trackunit API
TRACKUNIT_BASE_URL=https://iris.trackunit.com
TRACKUNIT_AUTH_GRANT_TYPE=client_credentials
TRACKUNIT_AUTH_URL=https://auth.trackunit.com/token/v2
TRACKUNIT_CLIENT_ID=
TRACKUNIT_CLIENT_SECRET=
TRACKUNIT_SCOPE=api.iso15143.snapshot api.iso15143.timeseries asset.view account.event.view
TRACKUNIT_USERNAME=
TRACKUNIT_PASSWORD=
TRACKUNIT_FLEET_SNAPSHOT_ENDPOINT=/public/api/aemp/v2/15143/-3/Fleet/{page}
TRACKUNIT_TIME_SERIES_ENDPOINT=
TRACKUNIT_SINGLE_ASSET_ENDPOINT=
TRACKUNIT_FAULTS_ENDPOINT=
TRACKUNIT_CAN_FAULTS_ENDPOINT=
TRACKUNIT_MACHINE_FAULTS_ENDPOINT=
TRACKUNIT_LIVE_TIMEOUT_SECONDS=10
TRACKUNIT_LIVE_RETRIES=1
TRACKUNIT_CACHE_FIRST=true
TRACKUNIT_CACHE_TTL_SECONDS=900
TRACKUNIT_REFRESH_STALE_CACHE_ON_ASK=false
TRACKUNIT_REALTIME_SINGLE_MACHINE=true
TRACKUNIT_AUTO_SYNC_ENABLED=false
TRACKUNIT_SYNC_INTERVAL_SECONDS=900
TRACKUNIT_AUTO_SYNC_RUN_ON_START=false

# Database
SQLITE_DB_PATH=data/trackunit_ai.db
DATABASE_URL=sqlite:///data/trackunit_ai.db

# Local AI
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Gemini cloud AI
# Do not put this key in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

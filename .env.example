# Data source: mock (5 simulated machines) | demo (the walkthrough scenario) |
# trackunit_cache (this machine's synced fleet).
# demo is a separate source rather than an extra machine in mock, so the shared fixture
# stays exactly as the offline walkthrough and the tests expect. See data/demo/SCENARIO.md.
DATA_SOURCE=mock

# Trackunit API
TRACKUNIT_BASE_URL=https://iris.trackunit.com
TRACKUNIT_AUTH_GRANT_TYPE=client_credentials
TRACKUNIT_AUTH_URL=https://auth.trackunit.com/token/v2
TRACKUNIT_CLIENT_ID=
TRACKUNIT_CLIENT_SECRET=
TRACKUNIT_SCOPE=api.iso15143.snapshot api.iso15143.timeseries asset.view account.event.view
TRACKUNIT_USERNAME=
TRACKUNIT_PASSWORD=
TRACKUNIT_FLEET_SNAPSHOT_ENDPOINT=/public/api/aemp/v2/15143/-3/Fleet/{page}
TRACKUNIT_TIME_SERIES_ENDPOINT=
TRACKUNIT_SINGLE_ASSET_ENDPOINT=
TRACKUNIT_FAULTS_ENDPOINT=
TRACKUNIT_CAN_FAULTS_ENDPOINT=
TRACKUNIT_MACHINE_FAULTS_ENDPOINT=
TRACKUNIT_LIVE_TIMEOUT_SECONDS=10
TRACKUNIT_LIVE_RETRIES=1
TRACKUNIT_CACHE_FIRST=true
TRACKUNIT_CACHE_TTL_SECONDS=900
TRACKUNIT_REFRESH_STALE_CACHE_ON_ASK=false
TRACKUNIT_REALTIME_SINGLE_MACHINE=true
TRACKUNIT_AUTO_SYNC_ENABLED=false
TRACKUNIT_SYNC_INTERVAL_SECONDS=900
TRACKUNIT_AUTO_SYNC_RUN_ON_START=false

# Database
SQLITE_DB_PATH=data/trackunit_ai.db
DATABASE_URL=sqlite:///data/trackunit_ai.db

# AI provider: deepseek (default), gemini, or ollama_local
AI_PROVIDER=deepseek

# DeepSeek cloud AI (non-thinking mode for interactive analysis)
# Keep credentials in the backend .env only, never in frontend or extension code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional local AI
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Gemini cloud AI
# Do not put this key in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: TypeSafe Jev, a System One model used only to rank retrieved manual
# sections before the language model reads them (app/typesafe_decision.py).
# It makes bounded judgements over a fixed answer space, so it is not a general
# chat model and is not a replacement for the provider above. Leave the key empty
# to skip the layer: retrieval order is then used and the report records that the
# ranking did not happen. Requires `pip install -r requirements-typesafe.txt`.
TYPESAFE_API_KEY=
# Pin a versioned model id when thresholds depend on behaviour; aliases can move.
# The response records the version the provider reports, not this alias.
TYPESAFE_MODEL=jev-latest

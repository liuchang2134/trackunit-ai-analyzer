{
  "manifest_version": 3,
  "name": "机联智检 · 车联网 AI 助手",
  "version": "0.9.25",
  "minimum_chrome_version": "114",
  "description": "在 Trackunit 旁查看设备证据、使用 AI 辅助排查并查询本地备件候选。",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://manager.trackunit.com/*",
    "https://new.manager.trackunit.com/*",
    "https://xgss.xcmg.com/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "打开机联智检",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:8890 http://127.0.0.1:8892"
  }
}

{
  "manifest_version": 3,
  "name": "机联智检 · 车联网 AI 助手",
  "version": "0.4.0",
  "minimum_chrome_version": "114",
  "description": "在 Trackunit 旁查看设备证据、使用 Gemini 辅助排查并查询本地备件候选。",
  "permissions": ["sidePanel", "activeTab"],
  "action": {"default_title": "打开机联智检"},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "panel.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:8890 http://127.0.0.1:8892"}
}
